{
  "name": "paypal-pact-harness-cd",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Postman-first contract testing for PayPal: a self-contained static BDC gate plus Harness stages for the official open-source Pact consumer/provider lifecycle.",
  "bin": {
    "pact-harness": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/fixtures-check.mjs && node scripts/validate-contract-topology.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "package:bundle": "node scripts/package-bundle.mjs",
    "test:packed": "node scripts/test-packed-bundle.mjs",
    "test:adoption": "node scripts/simulate-downstream-adoption.mjs",
    "postman:seed-demo": "node tools/pact-harness/scripts/postman/setup-workspace-simulation.mjs",
    "postman:setup": "node tools/pact-harness/scripts/postman/setup-workspace-simulation.mjs",
    "postman:inspect": "node tools/pact-harness/scripts/postman/run-workspace-simulation.mjs",
    "postman:verify": "node tools/pact-harness/scripts/postman/run-workspace-simulation.mjs",
    "handoff:doctor": "node scripts/tpe/prepare-handoff.mjs --check",
    "handoff:prepare": "node scripts/tpe/prepare-handoff.mjs",
    "test:all": "npm test && npm run check && npm run test:adoption && npm run build:bundle && npm run package:bundle && npm run test:packed",
    "doctor": "node paypal-contract-gate.mjs doctor",
    "verify:contract": "node paypal-contract-gate.mjs verify --clean",
    "demo": "node demo/demo.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
